# Docita SMS outreach — local-only mode.
# Mac + Android phone on the same WiFi. No cloud, no Firebase, no tunnel.
# Copy this file to `.env` and edit the values.

# --- SMS Gateway for Android (local mode) -------------------------------------
# 1. Install "SMS Gateway for Android" on the phone (Play Store).
# 2. Open the app → Settings → Local Server: pick a port + username + password.
# 3. Back on Home tab, flip "Local Server" ON, then tap "Offline" → "Online".
# 4. The phone shows its local IP (e.g. 192.168.1.50). Drop it in SMS_GATEWAY_URL.
SMS_GATEWAY_URL=http://192.168.1.50:8080
SMS_GATEWAY_USER=change_me
SMS_GATEWAY_PASS=change_me_too_min_8_chars

# --- Test target ---------------------------------------------------------------
# E.164 (with +). Used by `make test-doctor` to send 1 test SMS to yourself.
OWNER_PHONE_E164=+918790311010

# Partner invitation destination. Keep this configurable until Docita's public
# partner signup route is released; do not substitute a /book/{code} URL.
DOCITA_PARTNER_JOIN_URL=https://app.docita.work/partner

# --- Reply notifications (all optional) ---------------------------------------
# The inbox worker (make sms-inbox-poll) calls this on every reply.

# 1. Email via FormSubmit.co (default ON if NOTIFY_EMAIL is set)
#    No SMTP, no API key, no signup. Just set the target inbox.
#    First-time use: FormSubmit sends a confirmation email — click it once
#    to activate forwarding, and you're live forever.
#    Set NOTIFY_FORMSUBMIT=0 to disable without removing the address.
NOTIFY_EMAIL=notifications@docita.work

# 2. macOS Notification Center (default ON on Mac; set to 0 to silence)
# NOTIFY_MACOS=1

# 3. (Optional) SMTP fallback — leave blank unless you have a reason
# NOTIFY_SMTP_HOST=
# NOTIFY_SMTP_PORT=587
# NOTIFY_SMTP_USER=
# NOTIFY_SMTP_PASS=
# NOTIFY_SMTP_FROM=

# 4. Local log is always on at .sms_inbox_log.txt — no config needed.
